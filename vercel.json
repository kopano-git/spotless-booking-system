{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "config.wsgi:application",
      "buildCommand": "python manage.py collectstatic --noinput"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/admin/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/static/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "frontend" }
    }
  ]
}